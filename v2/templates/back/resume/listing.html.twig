{% extends "back/base.html.twig" %}

{% block title %}
    {{ title }}
{% endblock %}

{% block body %}
    <div class="row">
        <div class="col padding-md">
            {{ title }} <span class="badge badge-secondary">{{ resumes|length }}</span>
        </div>
        <div class="col padding-md align-right">
            <a href="{{ path('adminResumeAdd') }}"><span class="oi oi-plus float-right" title="Ajouter" aria-hidden="true"></span></a>
        </div>
    </div>
    <table class="table">
        <thead>
            <tr>
                <th scope="col">Id</th>
                <th scope="col">Date de modification</th>
                <th scope="col">Taille</th>
                <th scope="col">Modifier</th>
                <th scope="col">Supprimer</th>
            </tr>
        </thead>
        {% for resume in resumes %}
            <tr>
                <td scope="row">{{ resume.id }}</td>
                <td>{{ resume.dateTime | date("d/m/Y \\à H:i:s", "Europe/Paris") }}</td>
                <td>{{ resume.filesize }} octets</td>
                <td>
                    <a href="{{ path('adminResumeEdit', {'id': resume.id}) }}">
                        <span class="oi oi-pencil" title="Modifier" aria-hidden="true"></span>
                    </a>
                </td>
                <td>
                    <a href="{{ path('adminResumeDelete', {'id': resume.id}) }}">
                        <span class="oi oi-circle-x" title="Supprimer" aria-hidden="true"></span>
                    </a>
                </td>
            </tr>
        {% endfor %}
    </table>
{% endblock %}
